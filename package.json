{
  "name": "pharmadesk-erp",
  "productName": "PharmaDesk",
  "version": "1.0.0",
  "description": "PharmaDesk — Complete Pharmacy Management Desktop ERP & POS • Proud Production of ByteSphere",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "superadmin": "electron superadmin-desktop/main.js",
    "test": "node --test tests/test-suite.test.js",
    "seed": "node database/seed.js",
    "backend": "node backend/server.js",
    "admin": "node admin-panel/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "pharmacy",
    "erp",
    "billing",
    "inventory",
    "pos",
    "pharmadesk",
    "bytesphere",
    "sqlite",
    "electron"
  ],
  "author": "ByteSphere",
  "license": "Proprietary",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.bytesphere.pharmadesk",
    "productName": "PharmaDesk",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaDesk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "database/**/*",
      "services/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/better-sqlite3/**"
    ]
  }
}

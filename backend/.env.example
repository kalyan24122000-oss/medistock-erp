# MediStock Licensing Backend Configuration
PORT=5000
NODE_ENV=production

# Cryptographic salt for license key checksums and HMAC signing
LICENSE_SECRET_SALT=MEDISTOCK_PHARMACY_ERP_SECRET_KEY_2026

# Persistent storage directory for master license database (license_master.db)
DATA_DIR=./data
# DATABASE_PATH=/var/data/license_master.db

# SuperAdmin Initial Setup
DEFAULT_ADMIN_USER=superadmin
DEFAULT_ADMIN_PASS=masteradmin123
